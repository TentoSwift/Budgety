            "value": "打开 Budgety 以更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Budgety 以更新。"
          }
        }
      }
    },
    "為替レート未取得の明細を除く": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Buchungen mit fehlendem Wechselkurs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excludes entries without an exchange rate"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se excluyen los movimientos sin tipo de cambio"
          }
        },
        "fr": {
