    "シートを選択": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blatt auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Sheet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionar una hoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une feuille"
          }
        },
        "ko": {
          "stringUnit": {
