    "支出グラフ": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabendiagramm"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending chart"
          }
        },
