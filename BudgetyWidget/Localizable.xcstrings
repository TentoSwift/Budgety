    "選んだシートの今月の支出を表示します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Ausgaben dieses Monats für das ausgewählte Blatt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See spending for the current month on your selected sheet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los gastos de este mes en la hoja seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les dépenses du mois pour la feuille sélectionnée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시트의 이번 달 지출을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja os gastos deste mês na planilha selecionada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看所选账本的本月支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視所選帳本的本月支出。"
          }
        }
      }
    },
    "ウィジェットを編集してシートを選んでください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite das Widget und wähle ein Blatt aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit the widget to choose a sheet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita el widget para seleccionar una hoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le widget pour choisir une feuille."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 편집하여 시트를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite o widget para escolher uma planilha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑小组件以选择账本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯小工具以選擇帳本。"
          }
        }
      }
    },
    "Budgetyを開いて更新してください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Budgety zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Budgety to refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Budgety para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Budgety pour actualiser."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Budgety를 열어 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
