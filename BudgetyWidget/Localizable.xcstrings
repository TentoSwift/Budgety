    "選んだシートの今月の支出を日別の棒グラフで表示します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die täglichen Ausgaben dieses Monats für das ausgewählte Blatt als Balkendiagramm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See this month’s daily spending on the selected sheet in a bar chart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los gastos diarios de este mes en la hoja seleccionada en un gráfico de barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les dépenses quotidiennes du mois pour la feuille sélectionnée dans un graphique en barres."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시트의 이번 달 일별 지출을 막대그래프로 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as despesas diárias deste mês na planilha selecionada em um gráfico de barras."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以柱状图显示所选账本本月的每日支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以長條圖顯示所選帳本本月的每日支出。"
          }
        }
      }
    },
