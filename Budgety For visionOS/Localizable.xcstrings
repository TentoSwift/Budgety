      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einladungslink konnte nicht abgerufen werden. Stelle sicher, dass du bei iCloud angemeldet bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t get the invite link. Make sure you’re signed in to iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener el enlace de invitación. Comprueba que has iniciado sesión en iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir le lien d'invitation. Vérifiez que vous êtes connecté(e) à iCloud."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크를 가져올 수 없었습니다. iCloud에 로그인되어 있는지 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter o link de convite. Verifique se você está conectado ao iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
