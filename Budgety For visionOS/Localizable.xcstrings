    "iCloud ストアの初期化が完了していません。少し待ってから再度お試しください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iCloud-Speicher ist noch nicht bereit. Bitte warte einen Moment und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud store isn’t ready yet. Please wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén de iCloud aún no está listo. Espera un momento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'initialisation du stockage iCloud n'est pas terminée. Veuillez patienter un instant et réessayer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장소 초기화가 완료되지 않았습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do iCloud ainda não está pronto. Aguarde um momento e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 存储初始化尚未完成，请稍候片刻后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 儲存區尚未初始化完成，請稍候片刻後再試一次。"
          }
        }
      }
    },
