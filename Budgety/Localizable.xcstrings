          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence로 카테고리를 자동 추측하고, Siri 단축어로 빠르게 기록할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adivinhe categorias automaticamente com a Apple Intelligence e registre rapidamente com atalhos da Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple Intelligence 自动推测分类，并使用 Siri 快捷指令快速记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 Apple Intelligence 自動推測分類，並利用 Siri 捷徑快速記錄。"
          }
        }
      }
    },
