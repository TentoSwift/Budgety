            "state": "translated",
            "value": "Miembros que no están en esta hoja"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Membres absents de cette feuille"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시트에 없는 멤버"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Membros que não estão nesta planilha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
