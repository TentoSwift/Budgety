    "シートとカテゴリで使える特別なアイコンを利用できます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze spezielle Symbole für Blätter und Kategorien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use special icons for sheets and categories."
          }
        },
        "es": {
          "stringUnit": {
