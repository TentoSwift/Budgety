          }
        }
      }
    },
    "海外旅行や外貨支出も同じシートで管理。為替レートで自動換算します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalte Auslandsreisen und Ausgaben in Fremdwährung im selben Blatt. Beträge werden automatisch anhand des Wechselkurses umgerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage overseas trips and foreign-currency spending in the same sheet. Amounts are converted automatically using exchange rates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona viajes al extranjero y gastos en moneda extranjera en la misma hoja. Los importes se convierten automáticamente con el tipo de cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez vos voyages à l'étranger et vos dépenses en devises étrangères dans la même feuille. Les montants sont convertis automatiquement selon les taux de change."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해외여행이나 외화 지출도 같은 시트에서 관리합니다. 환율로 자동 환산됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie viagens internacionais e despesas em moeda estrangeira na mesma planilha. Os valores são convertidos automaticamente pela taxa de câmbio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "境外旅行和外币支出也可在同一账本中管理，按汇率自动换算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海外旅行與外幣支出也能在同一帳本中管理，並依匯率自動換算。"
          }
        }
      }
    },
    "為替サーバから応答がありません": {
      "localizations": {
        "de": {
          "stringUnit": {
