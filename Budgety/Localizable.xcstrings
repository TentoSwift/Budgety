    "%@として記録できるのはこのシートのオーナー・参加者・バーチャルメンバーです。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Eigentümer, die Teilnehmer und virtuelle Mitglieder dieses Blatts können als %@ erfasst werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the owner, participants, and virtual members of this sheet can be recorded as %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el propietario, los participantes y los miembros virtuales de esta hoja pueden registrarse como %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls le propriétaire, les participants et les membres virtuels de cette feuille peuvent être enregistrés comme %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 기록할 수 있는 것은 이 시트의 소유자, 참가자, 가상 멤버뿐입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o proprietário, os participantes e os membros virtuais desta planilha podem ser registrados como %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此账本的所有者、参与者和虚拟成员才能作为 %@ 记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有此帳本的擁有者、參加者及虛擬成員可被記錄為 %@。"
          }
        }
      }
    },
