    "チェックした人で均等割りします。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßig unter den ausgewählten Personen aufteilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split equally among the checked people."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide en partes iguales entre las personas marcadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartir équitablement entre les personnes cochées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크한 사람끼리 균등하게 나눕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide igualmente entre as pessoas marcadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已勾选的人之间平均分摊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由勾選的成員均分。"
          }
        }
      }
    },
    "チェックを入れたメンバーで支出額を均等に割って精算します。全員未選択の場合は「全員均等割り」として扱います。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt den Ausgabenbetrag gleichmäßig unter den ausgewählten Mitgliedern auf. Ist niemand ausgewählt, gilt „Gleichmäßig unter allen aufteilen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits the expense equally among the checked members. If none are selected, it is treated as \"split equally among everyone.\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide el importe del gasto en partes iguales entre los miembros marcados. Si no se selecciona a nadie, se trata como \"dividir en partes iguales entre todos\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartit équitablement le montant de la dépense entre les membres cochés. Si personne n'est sélectionné, cela équivaut à « répartition égale entre tous »."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크한 멤버끼리 지출 금액을 균등하게 나누어 정산합니다. 아무도 선택하지 않으면 “전원 균등 분할”로 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide o valor da despesa igualmente entre os membros marcados para o acerto de contas. Se ninguém for selecionado, será tratado como \"dividir igualmente entre todos\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将支出金额在已勾选的成员之间平均分摊结算。若全部未选，则视为“全员平均分摊”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由勾選的成員均分支出金額進行結算。若未勾選任何人，則視為「全員均分」。"
          }
        }
      }
    },
    "データベースの構造変更に伴い古いデータをリセットしました。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Daten wurden aufgrund einer Änderung der Datenbankstruktur zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old data was reset due to a database structure change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecieron los datos antiguos debido a un cambio en la estructura de la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes données ont été réinitialisées suite à un changement de structure de la base de données."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 구조 변경으로 인해 이전 데이터를 초기화했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados antigos foram redefinidos devido a uma alteração na estrutura do banco de dados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于数据库结构变更，已重置旧数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因資料庫結構變更，已重設舊有資料。"
          }
        }
      }
    },
    "データベースをリセットしました": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde zurückgesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database has been reset"
          }
        },
        "es": {
