            "value": "가족이나 파트너를 초대해 하나의 가계부를 함께 관리할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide familiares ou seu parceiro para gerenciar um orçamento juntos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请家人或伴侣共同管理同一本账本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請家人或伴侶，一起管理同一本家計簿。"
          }
        }
      }
    },
    "家族や友人と共有": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Familie und Freunden teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share with family and friends"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte con familiares y amigos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager avec la famille et les amis"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족이나 친구와 공유"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe com família e amigos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与家人朋友共享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與家人朋友共用"
          }
        }
      }
    },
    "家計・旅行・イベントなど、用途ごとにシートを作って支出を分けて管理できます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle für jeden Zweck – Haushalt, Reisen, Events und mehr – ein eigenes Blatt, um Ausgaben getrennt zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a separate sheet for each purpose—household, travel, events, and more—to manage your expenses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una hoja para cada propósito —hogar, viajes, eventos y más— y gestiona los gastos por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une feuille distincte pour chaque usage — ménage, voyages, événements, etc. — pour gérer vos dépenses séparément."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가계, 여행, 이벤트 등 용도별로 시트를 만들어 지출을 나눠 관리할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma planilha para cada finalidade — orçamento doméstico, viagens, eventos e mais — para gerenciar suas despesas separadamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可按用途（家庭、旅行、活动等）创建不同账本，分开管理支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可依用途（家計、旅行、活動等）建立不同帳本，分開管理支出。"
          }
        }
      }
    },
    "家計・旅行・サークルなど、用途ごとにシートを作って独立した家計簿として使えます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle für jeden Zweck – Haushalt, Reisen, Gruppen – ein eigenes Blatt und nutze es als unabhängiges Haushaltsbuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a sheet for each purpose—household, travel, clubs—and use them as independent budgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una hoja para cada propósito —hogar, viajes, grupos— y úsalas como presupuestos independientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une feuille pour chaque usage — ménage, voyages, clubs — et utilisez-les comme des budgets indépendants."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가계, 여행, 동아리 등 용도별로 시트를 만들어 독립된 가계부로 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma planilha para cada finalidade — orçamento doméstico, viagens, grupos — e use-as como orçamentos independentes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可按用途（家庭、旅行、社团等）创建账本，作为独立的账本使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可依用途（家計、旅行、社團等）建立帳本，作為獨立的家計簿使用。"
          }
        }
      }
    },
    "家計データを書き出してバックアップや共有ができます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere deine Haushaltsdaten, um sie zu sichern oder zu teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export your budget data to back it up or share it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tus datos de presupuesto para respaldarlos o compartirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez vos données budgétaires pour les sauvegarder ou les partager."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가계 데이터를 내보내서 백업하거나 공유할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte seus dados financeiros para fazer backup ou compartilhá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可导出账本数据用于备份或共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可匯出家計資料進行備份或分享。"
          }
        }
      }
    },
    "家計を 1 タップで記録": {
