          }
        }
      }
    },
    "この操作は元に戻せません。削除後はアプリを再起動してください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorgang kann nicht rückgängig gemacht werden. Starte die App nach dem Löschen neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone. Please restart the app after deleting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer. Reinicia la app después de eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Veuillez redémarrer l'application après la suppression."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다. 삭제 후 앱을 다시 시작해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita. Reinicie o app depois de excluir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。删除后请重启应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法復原。刪除後請重新啟動 App。"
          }
        }
      }
    },
    "この支出は定期項目から生成されています。この項目だけ変更するか、定期項目全体を変更するか選んでください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausgabe wurde aus einem wiederkehrenden Eintrag erzeugt. Wähle, ob nur dieser Eintrag oder der gesamte wiederkehrende Eintrag geändert werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This expense was generated from a recurring item. Choose whether to change only this item or the entire recurring item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este gasto se generó a partir de un elemento recurrente. Elige si quieres cambiar solo este elemento o todo el elemento recurrente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette dépense a été générée à partir d'un élément récurrent. Choisissez de modifier uniquement cet élément ou l'élément récurrent entier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지출은 정기 항목에서 생성되었습니다. 이 항목만 변경할지, 정기 항목 전체를 변경할지 선택해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta despesa foi gerada a partir de um item recorrente. Escolha entre alterar apenas este item ou o item recorrente inteiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此支出由定期项目生成。请选择仅更改此项目，还是更改整个定期项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此支出是由定期項目產生的。請選擇僅變更此項目，或變更整個定期項目。"
          }
        }
      }
    },
