    "4 桁以上の数字。絶対に忘れないようにしてください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens 4 Ziffern. Merke sie dir gut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 4 digits. Be sure not to forget it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 4 dígitos. Asegúrate de no olvidarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins 4 chiffres. Veillez à ne pas l'oublier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "4자리 이상의 숫자입니다. 절대 잊어버리지 않도록 주의하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos 4 dígitos. Não se esqueça dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4 位或以上的数字，请务必牢记。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 4 位數字。請務必牢記，切勿忘記。"
          }
        }
      }
    },
