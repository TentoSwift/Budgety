    "他の端末で作ったシートが降りてくるまでお待ちください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte warte, bis Blätter, die auf anderen Geräten erstellt wurden, synchronisiert sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait for sheets created on other devices to sync down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que se sincronicen las hojas creadas en otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez attendre que les feuilles créées sur d'autres appareils se synchronisent."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 만든 시트가 동기화될 때까지 기다려 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a sincronização das planilhas criadas em outros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待在其他设备上创建的账本同步下来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍候，等待在其他裝置上建立的帳本同步下載。"
          }
        }
      }
    },
    "以前に記録した送金です。残高に反映されます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuvor erfasste Überweisungen. Sie werden im Saldo berücksichtigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers recorded earlier. They’re reflected in balances."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferencias registradas anteriormente. Se reflejan en los saldos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virements enregistrés précédemment. Ils sont pris en compte dans les soldes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 기록한 송금입니다. 잔액에 반영됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências registradas anteriormente. Elas são refletidas nos saldos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前记录的转账，将反映在余额中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此為先前記錄的匯款，將反映於餘額中。"
          }
        }
      }
    },
