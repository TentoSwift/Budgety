    "支出/収入の追加・取得、定期項目の追加を 1 つの JSON 入力で行います。op='add' / 'get' / 'recurring'。MCP / 自動化向け。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Ausgaben/Einnahmen hinzu oder ruft sie ab und fügt wiederkehrende Einträge über eine einzige JSON-Eingabe hinzu. op='add' / 'get' / 'recurring'. Für MCP/Automatisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add or fetch expenses/income and add recurring items with a single JSON input. op='add' / 'get' / 'recurring'. For MCP / automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade u obtén gastos/ingresos y añade elementos recurrentes con una sola entrada JSON. op='add' / 'get' / 'recurring'. Para MCP / automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez ou récupérez des dépenses/revenus et ajoutez des éléments récurrents avec une seule entrée JSON. op='add' / 'get' / 'recurring'. Pour MCP / automatisation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지출/수입 추가·조회, 정기 항목 추가를 하나의 JSON 입력으로 처리합니다. op='add' / 'get' / 'recurring'. MCP/자동화용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione ou busque despesas/receitas e adicione itens recorrentes com uma única entrada JSON. op='add' / 'get' / 'recurring'. Para MCP / automação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过一个 JSON 输入完成支出/收入的添加与获取，以及定期项目的添加。op='add' / 'get' / 'recurring'。用于 MCP / 自动化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以單一 JSON 輸入完成新增／取得支出或收入，以及新增定期項目。op='add' / 'get' / 'recurring'。適用於 MCP／自動化。"
          }
        }
      }
    },
