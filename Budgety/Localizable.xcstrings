    "過去の支出で使われている場合、履歴を保つためアーカイブされ、新規の割り勘候補から外れます。使われていなければ完全に削除されます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird sie in vergangenen Ausgaben verwendet, wird sie zur Erhaltung des Verlaufs archiviert und aus neuen Aufteilungsvorschlägen entfernt. Wird sie nicht verwendet, wird sie endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If used by past expenses, it is archived to preserve history and removed from new split candidates. If unused, it is permanently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se usa en gastos anteriores, se archivará para conservar el historial y se excluirá de los nuevos candidatos de división. Si no se usa, se eliminará por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elle est utilisée par des dépenses passées, elle est archivée pour préserver l'historique et exclue des nouveaux candidats de partage. Si elle n'est pas utilisée, elle est définitivement supprimée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 지출에 사용된 경우 이력을 유지하기 위해 보관되며, 새 정산 후보에서 제외됩니다. 사용되지 않았다면 완전히 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estiver em uso em despesas anteriores, será arquivado para preservar o histórico e removido das opções de divisão para novas despesas. Se não estiver em uso, será excluído permanentemente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果已被过往支出使用，将被归档以保留历史记录，并从新的分摊候选中移除；如果未被使用，则会被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若已用於過去的支出，將會封存以保留記錄，並從新分帳候選中移除；若未使用，則會永久刪除。"
          }
        }
      }
    },
