    "“%@”から退出します。オーナーや他の参加者のデータは残ります。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du verlässt „%@“. Die Daten des Eigentümers und der anderen Teilnehmer bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will leave “%@”. The owner's and other participants' data will remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldrás de “%@”. Los datos del propietario y de los demás participantes se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous allez quitter « %@ ». Les données du propriétaire et des autres participants seront conservées."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”에서 나갑니다. 소유자 및 다른 참가자의 데이터는 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai sair de “%@”. Os dados do proprietário e dos outros participantes permanecerão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将退出“%@”，所有者和其他参与者的数据将予以保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將退出「%@」。擁有者及其他參加者的資料將保留。"
          }
        }
      }
    },
