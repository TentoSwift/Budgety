            "state": "translated",
            "value": "Für den KI-Chat sind iOS 26 oder neuer sowie ein Apple Intelligence-fähiges Gerät erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Chat requires iOS 26+ and an Apple Intelligence–capable device."
