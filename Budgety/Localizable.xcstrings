    "「コーヒー 350 円」と話しかけるだけで支出を記録できます。": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag einfach „Kaffee 350 Yen“, um eine Ausgabe zu erfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just say “Coffee 350 yen” to record an expense."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo di “Café 350 yenes” para registrar un gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites simplement « Café 350 yens » pour enregistrer une dépense."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“커피 350엔”이라고 말하기만 해도 지출을 기록할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta dizer “Café, 350 ienes” para registrar uma despesa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需说出“咖啡 350 日元”即可记录支出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要說出「咖啡 350 元」，就能記錄支出。"
          }
        }
      }
    },
    "「コーヒー 350 円」と話しかけるだけで支出を記録できます。(macOS 版のみ)": {
      "localizations": {
