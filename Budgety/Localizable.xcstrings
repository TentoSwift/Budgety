          "stringUnit": {
            "state": "translated",
            "value": "AI 채팅을 사용하려면 iOS 26 이상과 Apple Intelligence를 지원하는 기기가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
