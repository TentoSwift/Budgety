    "シートを削除しますか?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blatt löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete sheet?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar hoja?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer la feuille ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 삭제하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir planilha?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除账本吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要刪除帳本嗎？"
          }
        }
      }
    },
    "シートを削除するとすべての支出も削除されます。共有中のメンバーからもアクセスできなくなります。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen eines Blatts werden auch alle Ausgaben gelöscht. Geteilte Mitglieder verlieren ebenfalls den Zugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a sheet deletes all its expenses. Shared members will also lose access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar una hoja también se eliminan todos sus gastos. Los miembros con quienes la compartes perderán el acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer une feuille supprime aussi toutes ses dépenses. Les membres partagés perdront également l'accès."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트를 삭제하면 모든 지출도 함께 삭제됩니다. 공유 중인 멤버도 더 이상 접근할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir uma planilha também exclui todas as suas despesas. Os membros com quem ela é compartilhada também perderão o acesso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除账本将同时删除其所有支出，共享成员也将无法再访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除帳本將同時刪除所有支出，共用中的成員也將無法再存取。"
          }
        }
      }
    },
