            "state": "translated",
            "value": "Alte Daten wurden aufgrund einer Änderung der Datenbankstruktur zurückgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old data was reset due to a database structure change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablecieron los datos antiguos debido a un cambio en la estructura de la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciennes données ont été réinitialisées suite à un changement de structure de la base de données."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 구조 변경으로 인해 이전 데이터를 초기화했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados antigos foram redefinidos devido a uma alteração na estrutura do banco de dados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于数据库结构变更，已重置旧数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因資料庫結構變更，已重設舊有資料。"
          }
        }
      }
    },
    "データベースを再構築しました。アプリを再起動してください。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenbank wurde neu aufgebaut. Bitte starte die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database has been rebuilt. Please restart the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reconstruyó la base de datos. Reinicia la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données a été reconstruite. Veuillez redémarrer l'application."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스를 재구성했습니다. 앱을 다시 시작해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados foi reconstruído. Reinicie o app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据库已重建，请重启应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料庫已重建，請重新啟動 App。"
          }
        }
      }
    },
    "データベース構造の不整合を検出しました。アプリを再起動するとデータをリセットして復旧します。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Inkonsistenz in der Datenbankstruktur wurde erkannt. Ein Neustart der App setzt die Daten zurück und stellt sie wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A database structure inconsistency was detected. Restarting the app will reset the data and recover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detectó una incoherencia en la estructura de la base de datos. Si reinicias la app, se restablecerán los datos para recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une incohérence dans la structure de la base de données a été détectée. Redémarrer l'application réinitialisera les données pour les restaurer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 구조에서 불일치가 감지되었습니다. 앱을 다시 시작하면 데이터를 초기화하여 복구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi detectada uma inconsistência na estrutura do banco de dados. Reiniciar o app redefinirá os dados e fará a recuperação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到数据库结构不一致。重启应用将重置数据以恢复正常。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到資料庫結構不一致。重新啟動 App 後將重設資料以進行復原。"
          }
        }
      }
    },
